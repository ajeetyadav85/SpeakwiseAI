{
  "name": "speakwise-ai",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "build": "cd server && npm install && npm run build && cd ../client && npm install && npm run build",
    "start": "cd client && npm run preview -- --host 0.0.0.0"
  },
  "allowScripts": {
    "esbuild": true,
    "@firebase/util": true,
    "protobufjs": true,
    "esbuild@0.21.5": true,
    "@firebase/util@1.15.2": true,
    "protobufjs@7.6.5": true
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "razorpay": "^2.9.8"
  }
}
